# ── Copy to .env, fill in, keep secret (chmod 600). ─────────────────────────
# The app refuses to start if a required value below is missing or a
# placeholder. Only this file's bootstrap secrets need to be set before first
# boot — storage credentials and the public domain can be left blank here and
# set instead from /admin/settings → Storage & domain once you've logged in
# (they're encrypted at rest in the database, see db/007_config_and_categories.sql).
# The in-app settings page has a "where to find this" guide under every field.

# Postgres (the compose file creates this database; pick a strong password)
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://gallery:CHANGE_ME@db:5432/gallery

# openssl rand -base64 32   (run three times, paste each below)
AUTH_SECRET=CHANGE_ME
WORKER_SHARED_SECRET=CHANGE_ME
# Encrypts storage credentials + domain saved via /admin/settings. Generate it
# once at install and never change it afterwards — changing it makes every
# secret already saved in the database undecryptable (you'd have to re-enter
# them). Not needed at all if you'd rather manage S3_* below by hand instead.
ENCRYPTION_KEY=CHANGE_ME

# ── Storage (Cloudflare R2 — egress is free) ────────────────────────────────
# From Cloudflare dashboard → R2. Endpoint is on the bucket's Settings page:
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#
# S3_ENDPOINT must be set HERE, not just in /admin/settings: the browser's
# upload permission (CSP) is stamped onto every response by middleware.ts,
# which runs on Next's Edge runtime and can't reach the database or decrypt
# anything — it only ever sees this env var. Get the endpoint right here once
# at install; it rarely needs to change.
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
# Everything below CAN be left blank and set instead from /admin/settings →
# Storage & domain after first login (encrypted at rest, no redeploy needed
# to change later) — the fields above are the exception, not the rule.
S3_BUCKET=
# R2 → Manage API Tokens → Create token (Object Read & Write on this bucket)
S3_ACCESS_KEY=
S3_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
# Also settable from /admin/settings → Storage & domain; this is the fallback.
PUBLIC_SITE_URL=
THUMB_DIR=/app/public/thumbs

# ── White-label site identity (all optional — sensible defaults if unset) ───
# This is the app-wide chrome (title, admin nav, login page, home listing) —
# separate from per-gallery branding, which is set per-event in the admin UI.
# These are FALLBACKS ONLY as of db/005_site_settings.sql — once that
# migration is applied, /admin/settings (owner-only) is the primary way to
# set these (including uploading a logo/favicon), and any value set there
# overrides the matching env var below. Useful to leave these set anyway as
# the pre-migration/pre-first-login default.
SITE_NAME=Gallery
SITE_TAGLINE=Event galleries
# Any HTTPS URL. If it's on a different domain, it's automatically allow-listed
# in the CSP so the image isn't blocked. Ignored once a logo is uploaded via
# /admin/settings.
SITE_LOGO_URL=
SITE_PRIMARY_COLOR=#E8442A
SITE_ACCENT_COLOR=#C6B400
