# ── Copy to .env, fill in, keep secret (chmod 600). ─────────────────────────
# The app refuses to start if a required value is missing or a placeholder.

# Postgres (the compose file creates this database; pick a strong password)
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://gallery:CHANGE_ME@db:5432/gallery

# ── Cloudflare R2 storage (egress is free) ──────────────────────────────────
# From Cloudflare dashboard → R2. Endpoint is on the bucket's Settings page:
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=memorial-gallery
# R2 → Manage API Tokens → Create token (Object Read & Write on this bucket)
S3_ACCESS_KEY=
S3_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://gallery.memorialstairclimb.com
# openssl rand -base64 32   (run twice, paste each)
AUTH_SECRET=CHANGE_ME
WORKER_SHARED_SECRET=CHANGE_ME
THUMB_DIR=/app/public/thumbs

# ── White-label site identity (all optional — sensible defaults if unset) ───
# This is the app-wide chrome (title, admin nav, login page, home listing) —
# separate from per-gallery branding, which is set per-event in the admin UI.
SITE_NAME=Gallery
SITE_TAGLINE=Event galleries
# Any HTTPS URL. If it's on a different domain, it's automatically allow-listed
# in the CSP so the image isn't blocked.
SITE_LOGO_URL=
SITE_PRIMARY_COLOR=#E8442A
SITE_ACCENT_COLOR=#C6B400
